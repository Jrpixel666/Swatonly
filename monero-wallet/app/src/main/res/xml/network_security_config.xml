<?xml version="1.0" encoding="utf-8"?>
<!-- The JVM side makes no connections; this locks it down anyway. The Rust core enforces its own
     stricter policy (bundled roots only, optional pinning, Tor). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
